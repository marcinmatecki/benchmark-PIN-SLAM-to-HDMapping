+    def save_pcd_binary(self, filename, points):
+        if hasattr(points, "detach"):
+            points = (
+                points.detach()
+                .cpu()
+                .numpy()
+            )
+
+        points = np.asarray(points)
+
+        if points.ndim != 2 or points.shape[1] < 3:
+            raise ValueError(
+                f"Invalid point cloud shape: {points.shape}"
+            )
+
+        xyz = points[:, :3].astype(
+            np.float32,
+            copy=False
+        )
+
+        if points.shape[1] >= 4:
+            intensity = points[:, 3].astype(
+                np.float32,
+                copy=False
+            )
+        else:
+            intensity = np.zeros(
+                xyz.shape[0],
+                dtype=np.float32
+            )
+
+        valid = np.isfinite(xyz).all(axis=1)
+
+        xyz = xyz[valid]
+        intensity = intensity[valid]
+
+        if len(xyz) == 0:
+            raise ValueError(
+                f"Empty point cloud: {filename}"
+            )
+
+        data = np.empty(
+            (len(xyz), 4),
+            dtype=np.float32
+        )
+
+        data[:, :3] = xyz
+        data[:, 3] = intensity
+
+        header = (
+            "# .PCD v0.7 - Point Cloud Data file format\n"
+            "VERSION 0.7\n"
+            "FIELDS x y z intensity\n"
+            "SIZE 4 4 4 4\n"
+            "TYPE F F F F\n"
+            "COUNT 1 1 1 1\n"
+            f"WIDTH {len(data)}\n"
+            "HEIGHT 1\n"
+            "VIEWPOINT 0 0 0 1 0 0 0\n"
+            f"POINTS {len(data)}\n"
+            "DATA binary\n"
+        ).encode("ascii")
+
+        os.makedirs(
+            os.path.dirname(filename),
+            exist_ok=True
+        )
+
+        with open(filename, "wb") as f:
+            f.write(header)
+            f.write(data.tobytes())
+
+        print(
+            f"[GTSAM PCD SAVED] "
+            f"{filename} "
+            f"points={len(data)}"
+        )
+    def save_loop_from_gtsam(
+        self,
+        cur_id,
+        loop_id,
+        current_points,
+        history_points,
+        current_time,
+        history_time
+        ):
+            """
+            Zapisuje loop closure na podstawie zoptymalizowanych pozy GTSAM.
+
+            Układ wynikowych PCD:
+                SOURCE -> układ HISTORY
+                TARGET -> układ HISTORY
+
+            GTSAM:
+                T_world_current = T_world<-current
+                T_world_history = T_world<-history
+
+                T_history_current =
+                    inv(T_world_history) @ T_world_current
+
+                T_history_world =
+                    inv(T_world_history)
+            """
+
+            if self.pgo_poses is None:
+                raise RuntimeError(
+                    "pgm.pgo_poses is None. "
+                    "GTSAM PGO nie został jeszcze wykonany."
+                )
+
+            # ============================================================
+            # GTSAM POSES
+            # ============================================================
+
+            T_world_current = np.asarray(
+                self.pgo_poses[cur_id],
+                dtype=np.float64
+            )
+
+            T_world_history = np.asarray(
+                self.pgo_poses[loop_id],
+                dtype=np.float64
+            )
+
+            # ============================================================
+            # TRANSFORMACJA:
+            #
+            # T_history<-current
+            # ============================================================
+
+            T_history_current = (
+                np.linalg.inv(T_world_history)
+                @ T_world_current
+            )
+
+            # ============================================================
+            # TRANSFORMACJA:
+            #
+            # T_history<-world
+            # ============================================================
+
+            T_history_world = np.linalg.inv(
+                T_world_history
+            )
+
+            # ============================================================
+            # CURRENT / SOURCE
+            #
+            # dataset.cur_source_points:
+            # current-local
+            #
+            # wynik:
+            # history-local
+            # ============================================================
+
+            if hasattr(
+                current_points,
+                "detach"
+            ):
+                current_points = (
+                    current_points
+                    .detach()
+                    .cpu()
+                    .numpy()
+                )
+
+            current_points = np.asarray(
+                current_points
+            )
+
+            if (
+                current_points.ndim != 2
+                or current_points.shape[1] < 3
+            ):
+                raise ValueError(
+                    "Invalid current point cloud shape: "
+                    f"{current_points.shape}"
+                )
+
+            current_xyz = (
+                current_points[:, :3]
+                .astype(np.float64)
+            )
+
+            current_xyz_history = (
+                current_xyz
+                @ T_history_current[:3, :3].T
+                + T_history_current[:3, 3]
+            )
+
+            if current_points.shape[1] >= 4:
+                current_intensity = (
+                    current_points[:, 3]
+                    .astype(np.float32)
+                )
+            else:
+                current_intensity = np.zeros(
+                    current_xyz.shape[0],
+                    dtype=np.float32
+                )
+
+            current_cloud = np.column_stack([
+                current_xyz_history,
+                current_intensity
+            ])
+
+            # ============================================================
+            # HISTORY / TARGET
+            #
+            # neural_points.local_neural_points:
+            # WORLD
+            #
+            # wynik:
+            # history-local
+            # ============================================================
+
+            if hasattr(
+                history_points,
+                "detach"
+            ):
+                history_points = (
+                    history_points
+                    .detach()
+                    .cpu()
+                    .numpy()
+                )
+
