+
+            history_xyz = (
+                history_points[:, :3]
+                .astype(np.float64)
+            )
+
+            history_xyz_history = (
+                history_xyz
+                @ T_history_world[:3, :3].T
+                + T_history_world[:3, 3]
+            )
+
+            if history_points.shape[1] >= 4:
